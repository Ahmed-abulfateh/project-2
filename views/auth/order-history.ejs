<!DOCTYPE html>
<html>
<head>
  <title>Order History</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .profile-container {
      max-width: 900px;
      margin: 30px auto;
      padding: 20px;
      background: white;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .profile-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      border-bottom: 2px solid #007bff;
      padding-bottom: 15px;
    }

    .profile-header h1 {
      margin: 0;
      color: #333;
    }

    .profile-nav {
      display: flex;
      gap: 15px;
      margin-bottom: 25px;
      justify-content: center;
    }

    .nav-link {
      padding: 8px 16px;
      border: 1px solid #ddd;
      border-radius: 4px;
      text-decoration: none;
      color: #007bff;
      transition: all 0.3s;
    }

    .nav-link:hover {
      background: #007bff;
      color: white;
    }

    .nav-link.active {
      background: #007bff;
      color: white;
    }

    .empty-state {
      text-align: center;
      padding: 40px;
      color: #666;
    }

    .order-card {
      border: 1px solid #ddd;
      border-radius: 6px;
      padding: 15px;
      margin-bottom: 15px;
      transition: all 0.3s;
    }

    .order-card:hover {
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      border-color: #007bff;
    }

    .order-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .order-id {
      font-weight: bold;
      color: #333;
      font-size: 14px;
    }

    .order-date {
      color: #666;
      font-size: 13px;
    }

    .order-status {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: bold;
    }

    .status-pending {
      background: #fff3cd;
      color: #856404;
    }

    .status-accepted {
      background: #d1ecf1;
      color: #0c5460;
    }

    .status-rejected {
      background: #f8d7da;
      color: #721c24;
    }

    .order-items {
      margin: 10px 0;
      font-size: 14px;
      color: #555;
    }

    .order-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid #eee;
      padding-top: 10px;
      margin-top: 10px;
    }

    .order-total {
      font-weight: bold;
      font-size: 16px;
      color: #28a745;
    }

    .btn-view {
      padding: 6px 12px;
      background: #007bff;
      color: white;
      text-decoration: none;
      border-radius: 4px;
      font-size: 13px;
      transition: all 0.3s;
    }

    .btn-view:hover {
      background: #0056b3;
    }
  </style>
</head>
<body>
  <%- include('../navbar.ejs') %>

  <div class="profile-container">
    <div class="profile-header">
      <h1>Order History</h1>
    </div>

    <div class="profile-nav">
      <a href="/profile" class="nav-link">Profile Info</a>
      <a href="/profile/orders" class="nav-link active">Order History</a>
      <a href="/profile/addresses" class="nav-link">Addresses</a>
    </div>

    <% if (orders.length === 0) { %>
      <div class="empty-state">
        <p>You haven't placed any orders yet.</p>
        <a href="/products" style="color: #007bff; text-decoration: none;">Start shopping →</a>
      </div>
    <% } else { %>
      <div>
        <% orders.forEach(order => { %>
          <div class="order-card">
            <div class="order-header">
              <div>
                <span class="order-id">Order #<%= order._id.toString().slice(-8).toUpperCase() %></span>
                <span class="order-date"><%= new Date(order.createdAt).toLocaleDateString() %></span>
              </div>
              <span class="order-status status-<%= order.orderStatus %>">
                <%= order.orderStatus.toUpperCase() %>
              </span>
            </div>

            <div class="order-items">
              <% order.items.forEach(item => { %>
                <div><%= item.product.name %> × <%= item.quantity %> @ $<%= item.price.toFixed(2) %></div>
              <% }) %>
            </div>

            <div class="order-footer">
              <div>
                <div style="color: #666; font-size: 13px;">To: <%= order.deliveryAddress %></div>
                <div style="color: #999; font-size: 12px;">Delivery: <span style="color: #666;"><%= order.deliveryStatus.toUpperCase() %></span></div>
              </div>
              <div style="text-align: right;">
                <div class="order-total">$<%= order.totalPrice.toFixed(2) %></div>
                <a href="/orders/<%= order._id %>" class="btn-view">View Details</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
