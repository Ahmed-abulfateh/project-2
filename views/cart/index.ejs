<!DOCTYPE html>
<html>
<head>
  <title>Shopping Cart</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .cart-container {
      max-width: 1000px;
      margin: 20px auto;
      padding: 20px;
    }
    
    .empty-cart {
      text-align: center;
      padding: 40px;
      color: #666;
    }
    
    .cart-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
    }
    
    .cart-table th,
    .cart-table td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    
    .cart-table th {
      background-color: #f5f5f5;
      font-weight: bold;
    }
    
    .quantity-input {
      width: 80px;
      padding: 5px;
      border: 1px solid #ddd;
    }
    
    .cart-summary {
      background-color: #f9f9f9;
      padding: 20px;
      border-radius: 5px;
      margin: 20px 0;
    }
    
    .cart-total {
      font-size: 24px;
      font-weight: bold;
      margin: 20px 0;
    }
    
    .checkout-form {
      background-color: #fff;
      padding: 20px;
      border: 1px solid #ddd;
      border-radius: 5px;
      margin: 20px 0;
    }
    
    .form-group {
      margin: 15px 0;
    }
    
    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }
    
    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 4px;
      box-sizing: border-box;
    }
    
    .button-group {
      display: flex;
      gap: 10px;
      margin: 20px 0;
    }
    
    .btn {
      padding: 10px 20px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
    }
    
    .btn-primary {
      background-color: #007bff;
      color: white;
    }
    
    .btn-primary:hover {
      background-color: #0056b3;
    }
    
    .btn-danger {
      background-color: #dc3545;
      color: white;
    }
    
    .btn-danger:hover {
      background-color: #c82333;
    }
    
    .btn-secondary {
      background-color: #6c757d;
      color: white;
    }
    
    .btn-secondary:hover {
      background-color: #545b62;
    }

    .address-options {
      margin: 15px 0;
      padding: 15px;
      background-color: #f9f9f9;
      border-radius: 4px;
    }

    .address-option {
      margin: 10px 0;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 4px;
      cursor: pointer;
    }

    .address-option input[type="radio"] {
      margin-right: 10px;
      cursor: pointer;
    }

    .address-option label {
      cursor: pointer;
      display: inline;
      margin-bottom: 0;
      font-weight: normal;
    }

    .address-text {
      margin-left: 25px;
      color: #666;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
  </style>
</head>
<body>
  <%- include('../navbar.ejs') %>
  
  <div class="cart-container">
    <h1>Shopping Cart</h1>
    
    <% if (cartItems.length === 0) { %>
      <div class="empty-cart">
        <p>Your cart is empty.</p>
        <a href="/products" class="btn btn-primary">Continue Shopping</a>
      </div>
    <% } else { %>
      <table class="cart-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Subtotal</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% cartItems.forEach(item => { %>
            <tr>
              <td><%= item.name %></td>
              <td>$<%= item.price %></td>
              <td>
                <form action="/cart/<%= item.productId %>?_method=PUT" method="POST" style="display: inline;">
                  <input type="number" name="quantity" value="<%= item.quantity %>" min="1" class="quantity-input">
                  <button type="submit" class="btn btn-secondary" style="padding: 5px 10px; width: auto;">Update</button>
                </form>
              </td>
              <td>$<%= (item.price * item.quantity).toFixed(2) %></td>
              <td>
                <form action="/cart/<%= item.productId %>?_method=DELETE" method="POST" style="display: inline;">
                  <button type="submit" class="btn btn-danger" style="padding: 5px 10px; width: auto;">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      
      <div class="cart-summary">
        <div class="cart-total">Total: $<%= totalPrice.toFixed(2) %></div>
        
        <form action="/orders" method="POST" class="checkout-form" id="checkoutForm">
          <input type="hidden" name="appliedCoupon" id="appliedCouponField" value="">
          <input type="hidden" name="discountAmount" id="discountAmountField" value="0">
          <h2>Delivery Address</h2>
                   <div style="background: #f8f9fa; padding: 15px; border-radius: 6px; margin-bottom: 20px; border: 1px solid #ddd;">
                     <h3 style="margin-top: 0;">Apply Coupon Code</h3>
                     <div style="display: flex; gap: 10px;">
                       <input type="text" id="couponCode" placeholder="Enter coupon code" style="flex: 1; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                       <button type="button" id="applyCouponBtn" class="btn btn-info" onclick="applyCoupon()" style="padding: 8px 20px;">Apply</button>
                     </div>
                     <div id="couponMessage" style="margin-top: 10px; padding: 10px; border-radius: 4px; display: none;"></div>
                     <div id="couponDiscount" style="margin-top: 10px; color: #28a745; font-weight: bold; display: none;">
                       Discount Applied: <span id="discountAmount">$0.00</span>
                       <button type="button" onclick="removeCoupon()" style="margin-left: 10px; padding: 4px 12px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;">Remove</button>
                     </div>
                   </div>
          
          <% if (user.address) { %>
            <div class="address-options">
              <h3>Select Address</h3>
              <div class="address-option">
                <input type="radio" id="savedAddress" name="addressOption" value="saved" checked>
                <label for="savedAddress">Use Saved Address from Profile</label>
                <div class="address-text"><%= user.address %></div>
              </div>
              
              <div class="address-option">
                <input type="radio" id="newAddress" name="addressOption" value="new">
                <label for="newAddress">Enter New Address</label>
              </div>
            </div>
          <% } %>
          
          <div class="form-group" id="deliveryAddressGroup">
            <label for="deliveryAddress">Delivery Address *</label>
            <textarea id="deliveryAddress" name="deliveryAddress" placeholder="Enter your delivery address"><% if (user.address) { %><%= user.address %><% } %></textarea>
          </div>
          
          <div class="button-group">
            <button type="submit" class="btn btn-primary">Checkout</button>
            <a href="/products" class="btn btn-secondary">Continue Shopping</a>
            <form action="/cart/clear" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-danger">Clear Cart</button>
            </form>
          </div>
        </form>
      </div>
    <% } %>
  </div>

  <script>
    // Handle address option switching
    const addressOptions = document.querySelectorAll('input[name="addressOption"]');
    const deliveryAddressField = document.getElementById('deliveryAddress');
    const savedAddressText = '<%= user.address %>';

    if (addressOptions.length > 0) {
      addressOptions.forEach(option => {
        option.addEventListener('change', function() {
          if (this.value === 'saved') {
            deliveryAddressField.value = savedAddressText;
            deliveryAddressField.readOnly = true;
            deliveryAddressField.style.backgroundColor = '#f0f0f0';
          } else {
            deliveryAddressField.value = '';
            deliveryAddressField.readOnly = false;
            deliveryAddressField.style.backgroundColor = 'white';
          }
        });
      });
    }
  </script>
   <script>
     let appliedCoupon = null;
     let discountAmount = 0;

     function applyCoupon() {
       const code = document.getElementById('couponCode').value.trim();
       const messageDiv = document.getElementById('couponMessage');
       
       if (!code) {
         messageDiv.textContent = 'Please enter a coupon code';
         messageDiv.style.display = 'block';
         messageDiv.style.background = '#fff3cd';
         messageDiv.style.color = '#856404';
         return;
       }

       const orderTotal = <%= totalPrice %>;

       fetch('/coupons/validate', {
         method: 'POST',
         headers: {
           'Content-Type': 'application/x-www-form-urlencoded'
         },
         body: `code=${encodeURIComponent(code)}&orderTotal=${orderTotal}`
       })
       .then(response => response.json())
       .then(data => {
         if (data.valid) {
           appliedCoupon = code;
           discountAmount = parseFloat(data.discount);
           
           // Update hidden fields
           document.getElementById('appliedCouponField').value = code;
           document.getElementById('discountAmountField').value = discountAmount;
           
           messageDiv.textContent = data.message;
           messageDiv.style.background = '#d4edda';
           messageDiv.style.color = '#155724';
           messageDiv.style.display = 'block';
           
           document.getElementById('couponDiscount').style.display = 'block';
           document.getElementById('discountAmount').textContent = '$' + discountAmount.toFixed(2);
           document.getElementById('couponCode').disabled = true;
           document.getElementById('applyCouponBtn').disabled = true;
         } else {
           messageDiv.textContent = data.message;
           messageDiv.style.background = '#f8d7da';
           messageDiv.style.color = '#721c24';
           messageDiv.style.display = 'block';
           document.getElementById('couponDiscount').style.display = 'none';
         }
       })
       .catch(error => {
         console.error('Error:', error);
         messageDiv.textContent = 'Error validating coupon';
         messageDiv.style.background = '#f8d7da';
         messageDiv.style.color = '#721c24';
         messageDiv.style.display = 'block';
       });
     }

     function removeCoupon() {
       appliedCoupon = null;
       discountAmount = 0;
       
       // Clear hidden fields
       document.getElementById('appliedCouponField').value = '';
       document.getElementById('discountAmountField').value = '0';
       
       document.getElementById('couponCode').value = '';
       document.getElementById('couponCode').disabled = false;
       document.getElementById('applyCouponBtn').disabled = false;
       document.getElementById('couponMessage').style.display = 'none';
       document.getElementById('couponDiscount').style.display = 'none';
     }

     // Allow Enter key to apply coupon
     document.getElementById('couponCode').addEventListener('keypress', function(e) {
       if (e.key === 'Enter') {
         applyCoupon();
       }
     });
   </script>
</body>
</html>
