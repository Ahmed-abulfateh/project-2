<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Commerce Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('navbar.ejs') %>

    <div class="container">
        <h1>Welcome to Our E-Commerce Store AHMAZON</h1>
        
        <% if (user) { %>
            <p>Welcome back, <strong><%= user.username %></strong>!</p>
            <% if (user.role === 'admin') { %>
                <div class="admin-home">
                    <h2>Admin Panel</h2>
                    <a href="/products/admin/dashboard" class="btn btn-primary">Manage Products</a>
                    <a href="/orders/admin/dashboard" class="btn btn-primary">Manage Orders</a>
                    <a href="/products/admin/stock-history" class="btn btn-primary">View Stock History</a>
                </div>
            <% } else { %>
                <div class="customer-home">
                    <h2>Start Shopping</h2>
                    <a href="/products" class="btn btn-success">Browse Products</a>
                    <a href="/orders" class="btn btn-info">My Orders</a>
                </div>

                <% if (recommendedProducts && recommendedProducts.length > 0) { %>
                    <div style="margin-top: 30px;">
                        <h2>Recommended For You</h2>
                        <div class="products-grid" style="margin-top: 15px;">
                            <% recommendedProducts.forEach(rec => { %>
                                <div class="product-card">
                                    <img src="<%= rec.imageUrl %>" alt="<%= rec.name %>" style="width: 100%; height: 160px; object-fit: cover; border-radius: 8px 8px 0 0; margin-bottom: 10px;">
                                    <span style="display: inline-block; background-color: #2196f3; color: white; padding: 4px 12px; border-radius: 12px; font-size: 0.85em; margin-bottom: 8px;"><%= rec.category %></span>
                                    <h3 style="margin: 5px 0;"><%= rec.name %></h3>
                                    <p class="price">$<%= rec.price.toFixed(2) %></p>
                                    <a href="/products/<%= rec._id %>" class="btn btn-info">View Details</a>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>
            <% } %>
        <% } else { %>
            <p>Please sign in to start shopping!</p>
            <div class="auth-buttons">
                <a href="/auth/sign-up" class="btn btn-success">Create Account</a>
                <a href="/auth/sign-in" class="btn btn-primary">Sign In</a>
            </div>
        <% } %>
    </div>
</body>
</html>