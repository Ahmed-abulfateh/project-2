<nav class="navbar">
  <div class="navbar-container">
    <div class="navbar-brand">
      <a href="/" class="logo">🛍️ Ahmaozn</a>
    </div>

    <div class="navbar-menu">
      <% if (user){ %>
        <!-- Logged In User Menu -->
        <a href="/" class="nav-link">Home</a>
        <a href="/products" class="nav-link">Shop</a>
        <a href="/cart" class="nav-link cart-link">
          🛒 Cart 
          <% if (cartCount > 0) { %>
            <span class="cart-badge"><%= cartCount %></span>
          <% } %>
        </a>
        <a href="/orders" class="nav-link">My Orders</a>
        
        <% if (user.role === 'admin') { %>
          <div class="nav-divider"></div>
          <a href="/products/admin/dashboard" class="nav-link admin-link">Manage Products</a>
          <a href="/orders/admin/dashboard" class="nav-link admin-link">Manage Orders</a>
          <a href="/products/admin/stock-history" class="nav-link admin-link">Stock History</a>
        <% } %>

        <div class="nav-user">
          <% if (!user.isEmailVerified) { %>
            <span class="email-warning" title="Email not verified">⚠️</span>
          <% } %>
          <div class="user-dropdown">
            <span class="user-name">👤 <%= user.username %></span>
            <div class="dropdown-content">
              <a href="/auth/change-email">Change Email</a>
              <a href="/auth/sign-out">Logout</a>
            </div>
          </div>
        </div>
      <% } else{ %>
        <!-- Not Logged In Menu -->
        <a href="/" class="nav-link">Home</a>
        <a href="/products" class="nav-link">Shop</a>
        <div class="nav-auth">
          <a href="/auth/sign-up" class="nav-link btn-signup">Sign Up</a>
          <a href="/auth/sign-in" class="nav-link btn-signin">Sign In</a>
        </div>
      <% } %>
    </div>
  </div>
</nav>

<style>
.navbar {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  padding: 0;
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: 0 4px 6px rgba(0,0,0,0.2);
}

.navbar-container {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 1rem;
}

.navbar-brand {
  display: flex;
  align-items: center;
  padding: 1rem 0;
}

.logo {
  font-size: 24px;
  font-weight: bold;
  color: #00d4ff;
  text-decoration: none;
  transition: color 0.3s;
}

.logo:hover {
  color: #00f0ff;
}

.navbar-menu {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.nav-link {
  color: white;
  text-decoration: none;
  padding: 0.75rem 1rem;
  border-radius: 4px;
  transition: all 0.3s;
  white-space: nowrap;
  font-size: 14px;
}

.nav-link:hover {
  background-color: rgba(0, 212, 255, 0.1);
  color: #00d4ff;
}

.cart-link {
  position: relative;
}

.cart-badge {
  background-color: #ff4444;
  color: white;
  border-radius: 50%;
  padding: 2px 6px;
  font-size: 12px;
  margin-left: 4px;
  font-weight: bold;
}

.admin-link {
  color: #ffaa00;
}

.admin-link:hover {
  background-color: rgba(255, 170, 0, 0.1);
  color: #ffc400;
}

.nav-divider {
  width: 1px;
  height: 24px;
  background-color: rgba(255, 255, 255, 0.2);
  margin: 0 0.5rem;
}

.nav-user {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-left: 1rem;
  border-left: 1px solid rgba(255, 255, 255, 0.2);
  padding-left: 1rem;
}

.email-warning {
  font-size: 18px;
  cursor: help;
}

.user-dropdown {
  position: relative;
}

.user-name {
  color: #00d4ff;
  padding: 0.75rem 1rem;
  border-radius: 4px;
  transition: all 0.3s;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.user-name:hover {
  background-color: rgba(0, 212, 255, 0.1);
}

.dropdown-content {
  display: none;
  position: absolute;
  right: 0;
  background-color: #16213e;
  min-width: 160px;
  box-shadow: 0 8px 16px rgba(0,0,0,0.3);
  z-index: 1001;
  border-radius: 4px;
  overflow: hidden;
  top: 100%;
  margin-top: 0.5rem;
}

.dropdown-content a {
  color: white;
  padding: 12px 16px;
  text-decoration: none;
  display: block;
  transition: background-color 0.3s;
  font-size: 14px;
}

.dropdown-content a:hover {
  background-color: rgba(0, 212, 255, 0.2);
  color: #00d4ff;
}

.user-dropdown:hover .dropdown-content {
  display: block;
}

.nav-auth {
  display: flex;
  gap: 0.5rem;
  margin-left: 1rem;
  border-left: 1px solid rgba(255, 255, 255, 0.2);
  padding-left: 1rem;
}

.btn-signup {
  background-color: #00d4ff;
  color: #1a1a2e;
  font-weight: bold;
}

.btn-signup:hover {
  background-color: #00f0ff;
  color: #1a1a2e;
}

.btn-signin {
  background-color: transparent;
  border: 2px solid #00d4ff;
  color: #00d4ff;
  font-weight: bold;
}

.btn-signin:hover {
  background-color: rgba(0, 212, 255, 0.1);
  border-color: #00f0ff;
  color: #00f0ff;
}

@media (max-width: 768px) {
  .navbar-container {
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
  }

  .navbar-menu {
    width: 100%;
    justify-content: center;
    gap: 0.5rem;
  }

  .nav-user {
    margin-left: 0;
    border-left: none;
    padding-left: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 1rem;
    width: 100%;
    justify-content: center;
  }

  .nav-auth {
    margin-left: 0;
    border-left: none;
    padding-left: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 1rem;
    width: 100%;
    justify-content: center;
  }

  .nav-divider {
    display: none;
  }
}
</style>
