<div class="navbar">
    <a href="/">Home</a>
    <% if (user){ %>
    <a href="/products">Shop</a>
    <a href="/cart">Cart (<%= cartCount %>)</a>
    <a href="/orders">My Orders</a>
    <% if (user.role === 'admin') { %>
    <a href="/products/admin/dashboard">Manage Products</a>
    <a href="/orders/admin/dashboard">Manage Orders</a>
    <a href="/products/admin/stock-history">Stock History</a>
    <% } %>
    <span>Welcome, <%= user.username %>!</span>
    <a href="/auth/sign-out">Logout</a>
    <% } else{ %>
    <a href="/auth/sign-up">Sign up</a>
    <a href="/auth/sign-in">Login</a>
    <% } %>
</div>
