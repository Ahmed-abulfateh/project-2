<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard - Orders</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .success-message {
      background: #d4edda;
      color: #155724;
      padding: 15px;
      border-radius: 4px;
      margin-bottom: 20px;
      border: 1px solid #c3e6cb;
    }
  </style>
</head>
<body>
  <%- include('../navbar.ejs') %>
  
  <div class="container">
    <h1>Admin Dashboard - Manage Orders</h1>
    
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="success-message">
        ✓ <%= success %>
      </div>
    <% } %>

    <div class="admin-section">
      <h3>Filter by Date</h3>
      <form action="/orders/admin/dashboard" method="GET" style="margin-top: 0;">
        <div class="form-group">
          <label for="startDate">Start Date</label>
          <input type="date" id="startDate" name="startDate" value="<%= startDate || '' %>">
        </div>
        <div class="form-group">
          <label for="endDate">End Date</label>
          <input type="date" id="endDate" name="endDate" value="<%= endDate || '' %>">
        </div>
        <div class="form-group">
          <label for="orderStatus">Order Status</label>
          <select id="orderStatus" name="orderStatus">
            <option value="all" <%= !orderStatus || orderStatus === 'all' ? 'selected' : '' %>>All</option>
            <option value="pending" <%= orderStatus === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="accepted" <%= orderStatus === 'accepted' ? 'selected' : '' %>>Accepted</option>
            <option value="rejected" <%= orderStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
          </select>
        </div>
        <div class="button-group" style="margin-top: 0;">
          <button class="btn btn-primary" type="submit">Apply Filter</button>
          <a href="/orders/admin/dashboard" class="btn btn-secondary">Clear</a>
        </div>
      </form>
    </div>
    
    <table class="orders-table admin-table">
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Customer</th>
          <th>Items</th>
          <th>Total</th>
          <th>Address</th>
          <th>Order Status</th>
          <th>Delivery Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(order => { %>
          <tr>
            <td><%= order._id %></td>
            <td><%= order.customer.username %> (<%= order.customer.email %>)</td>
            <td>
              <% order.items.forEach(item => { %>
                <div><%= item.product ? item.product.name : '[Deleted Product]' %> x <%= item.quantity %></div>
              <% }) %>
            </td>
            <td>$<%= order.totalPrice %></td>
            <td><%= order.deliveryAddress %></td>
            <td>
              <% if (order.orderStatus === 'pending') { %>
                <form action="/orders/<%= order._id %>/accept?_method=PUT" method="POST" style="display:inline;">
                  <button class="btn btn-success">Accept</button>
                </form>
                <form action="/orders/<%= order._id %>/reject?_method=PUT" method="POST" style="display:inline;">
                  <button class="btn btn-danger" onclick="return confirm('Reject this order?')">Reject</button>
                </form>
              <% } else { %>
                <span class="status status-<%= order.orderStatus %>"><%= order.orderStatus %></span>
              <% } %>
            </td>
            <td>
              <% if (order.orderStatus === 'accepted') { %>
                <form action="/orders/<%= order._id %>/delivery-status?_method=PUT" method="POST">
                  <select name="deliveryStatus" onchange="this.form.submit()">
                    <option value="not-shipped" <%= order.deliveryStatus === 'not-shipped' ? 'selected' : '' %>>Not Shipped</option>
                    <option value="in-transit" <%= order.deliveryStatus === 'in-transit' ? 'selected' : '' %>>In Transit</option>
                    <option value="delivered" <%= order.deliveryStatus === 'delivered' ? 'selected' : '' %>>Delivered</option>
                  </select>
                </form>
              <% } else { %>
                <span class="status status-<%= order.deliveryStatus %>"><%= order.deliveryStatus %></span>
              <% } %>
            </td>
            <td><a href="/orders/<%= order._id %>" class="btn btn-info">Details</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <script>
    // Preserve scroll position when page reloads
    window.addEventListener('beforeunload', function() {
      sessionStorage.setItem('scrollPosition', window.scrollY);
    });

    window.addEventListener('load', function() {
      const scrollPosition = sessionStorage.getItem('scrollPosition');
      if (scrollPosition) {
        window.scrollTo(0, parseInt(scrollPosition));
        sessionStorage.removeItem('scrollPosition');
      }
    });

    // Form submission preservation
    document.querySelectorAll('form').forEach(form => {
      form.addEventListener('submit', function(e) {
        sessionStorage.setItem('scrollPosition', window.scrollY);
      });
    });
  </script>
</body>
</html>
