<!DOCTYPE html>
<html>
<head>
  <title>My Orders</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../navbar.ejs') %>
  
  <div class="container">
    <h1>My Orders</h1>
    
    <% if (orders.length === 0) { %>
      <p>No orders yet. <a href="/products">Start shopping</a></p>
    <% } else { %>
      <table class="orders-table">
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Items</th>
            <th>Total Price</th>
            <th>Delivery Address</th>
            <th>Order Status</th>
            <th>Delivery Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(order => { %>
            <tr>
   <td><%= order._id %></td>
      <td>
     <% order.items.forEach(item => { %>
         <div><%= item.product.name %> x <%= item.quantity %></div>
         <% }) %>
              </td>
       <td>$<%= order.totalPrice %></td>
       <td><%= order.deliveryAddress %></td>
       <td><span class="status status-<%= order.orderStatus %>"><%= order.orderStatus %></span></td>
     <td><span class="status status-<%= order.deliveryStatus %>"><%= order.deliveryStatus %></span></td>
      <td><a href="/orders/<%= order._id %>" class="btn btn-info">View Details</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>
