<!DOCTYPE html>
<html>
<head>
  <title>Order Details</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../navbar.ejs') %>
  
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h1>Order Details</h1>
      <% if (user.role === 'admin') { %>
        <a href="/orders/admin/dashboard" class="btn btn-secondary" style="text-decoration: none; padding: 10px 20px;">← Back to Manage Orders</a>
      <% } else { %>
        <a href="/orders" class="btn btn-secondary" style="text-decoration: none; padding: 10px 20px;">← Back to My Orders</a>
      <% } %>
    </div>
    
    <div class="order-details">
      <h3>Order ID: <%= order._id %></h3>
      
      <div class="order-section">
        <h4>Items</h4>
        <table>
          <thead>
            <tr>
              <th>Product</th>
              <th>Quantity</th>
              <th>Price</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% order.items.forEach(item => { %>
              <tr>
                <td><%= item.product ? item.product.name : '[Deleted Product]' %></td>
                <td><%= item.quantity %></td>
                <td>$<%= item.price %></td>
                <td>$<%= item.price * item.quantity %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="order-section">
        <h4>Order Information</h4>
        <p><strong>Total Price:</strong> $<%= order.totalPrice.toFixed(2) %></p>
        <% if (order.discountAmount && order.discountAmount > 0) { %>
          <p><strong>Discount:</strong> <span style="color: #28a745;">-$<%= order.discountAmount.toFixed(2) %></span></p>
          <% if (order.couponCode) { %>
            <p><strong>Coupon Code:</strong> <span style="color: #007bff;"><%= order.couponCode %></span></p>
          <% } %>
        <% } %>
        <p><strong>Delivery Address:</strong> <%= order.deliveryAddress %></p>
        <p><strong>Order Status:</strong> <span class="status status-<%= order.orderStatus %>"><%= order.orderStatus %></span></p>
        <p><strong>Delivery Status:</strong> <span class="status status-<%= order.deliveryStatus %>"><%= order.deliveryStatus %></span></p>
        <p><strong>Ordered On:</strong> <%= new Date(order.createdAt).toLocaleDateString() %></p>
      </div>

      <% if (user.role === 'admin') { %>
        <a href="/orders/admin/dashboard" class="btn btn-secondary">← Back to Manage Orders</a>
      <% } else { %>
        <a href="/orders" class="btn btn-secondary">← Back to My Orders</a>
      <% } %>
    </div>
  </div>
</body>
</html>
