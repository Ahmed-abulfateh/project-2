<!DOCTYPE html>
<html>
<head>
  <title><%= product.name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .reviews-section {
      margin-top: 40px;
      padding: 20px;
      background-color: #f9f9f9;
      border-radius: 8px;
    }
    .review-form {
      background-color: white;
      padding: 20px;
      border-radius: 8px;
      margin-bottom: 30px;
      border: 1px solid #ddd;
    }
    .reviews-list {
      margin-top: 30px;
    }
    .review-item {
      background-color: white;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 8px;
      border-left: 4px solid #007bff;
    }
    .review-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .review-user {
      font-weight: bold;
      color: #333;
    }
    .review-date {
      color: #666;
      font-size: 0.9em;
    }
    .review-rating {
      color: #ff9800;
      font-size: 1.1em;
      margin-bottom: 10px;
    }
    .review-comment {
      color: #555;
      line-height: 1.5;
    }
    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }
    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 8px;
      margin-bottom: 15px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-family: inherit;
    }
    .form-group textarea {
      resize: vertical;
      min-height: 100px;
    }
    .btn-submit {
      background-color: #007bff;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    .btn-submit:hover {
      background-color: #0056b3;
    }
    .no-reviews {
      color: #666;
      font-style: italic;
      text-align: center;
      padding: 20px;
    }
    .btn-delete-review {
      background-color: #dc3545;
      color: white;
      padding: 5px 10px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.9em;
      margin-left: 10px;
    }
    .btn-delete-review:hover {
      background-color: #c82333;
    }
  </style>
</head>
<body>
  <%- include('../navbar.ejs') %>
  
  <div class="container">
    <h1><%= product.name %></h1>
    <p class="description"><%= product.description %></p>
    <p class="price">Price: $<%= product.price %></p>
    <p class="stock">Available Stock: <%= product.stock %></p>
    
    <% if (product.stock > 0) { %>
      <form action="/orders" method="POST" class="order-form">
        <div class="form-group">
          <label for="quantity">Quantity:</label>
          <input type="number" id="quantity" name="quantity" min="1" max="<%= product.stock %>" value="1" required>
        </div>
        <input type="hidden" name="productId" value="<%= product._id %>">
        <div class="form-group">
          <label for="deliveryAddress">Delivery Address:</label>
          <input type="text" id="deliveryAddress" name="deliveryAddress" placeholder="Enter delivery address" required>
        </div>
        <button type="submit" class="btn btn-success">Add to Cart & Checkout</button>
      </form>
    <% } else { %>
      <p class="out-of-stock">Out of Stock</p>
    <% } %>
    
    
    <div class="reviews-section">
      <h2>Customer Reviews</h2>
      
      
      <div class="review-form">
        <h3>Leave a Review</h3>
        <% if (userHasReviewed) { %>
          <p style="color: #ff9800; font-weight: bold;">You have already reviewed this product. You can only leave one review per product.</p>
        <% } else { %>
          <form action="/products/<%= product._id %>/reviews" method="POST">
            <div class="form-group">
           <label for="rating">Rating (1-5):</label>
        <input type="number" id="rating" name="rating" min="1" max="5" value="5" required>
         </div>
         <div class="form-group">
         <label for="comment">Comment:</label>
         <textarea id="comment" name="comment" placeholder="Share your thoughts about this product..." required></textarea>
       </div>
       <button type="submit" class="btn-submit">Submit Review</button>
          </form>
        <% } %>
      </div>
      
      
      <div class="reviews-list">
     <h3>All Reviews</h3>
   <% if (reviews && reviews.length > 0) { %>
    <% reviews.forEach(review => { %>
         <div class="review-item">
        <div class="review-header">
         <span class="review-user"><%= review.user.username %></span>
           <span class="review-date"><%= new Date(review.createdAt).toLocaleDateString() %></span>
           <% if (currentUser && currentUser.role === 'admin') { %>
             <form action="/products/<%= product._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" style="display: inline;">
               <button type="submit" class="btn-delete-review" onclick="return confirm('Are you sure you want to delete this review?')">Delete</button>
             </form>
           <% } %>
          </div>
              <div class="review-rating">
      ★ <%= review.rating %>/5
              </div>
        <div class="review-comment">
          <%= review.comment %>
              </div>
          </div>
        <% }); %>
        <% } else { %>
    <p class="no-reviews">No reviews yet. Be the first to review this product!</p>
        <% } %>
      </div>
    </div>
    
    <a href="/products" class="btn btn-secondary">Back to Products</a>
  </div>
</body>
</html>
